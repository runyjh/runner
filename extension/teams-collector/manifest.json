{
  "manifest_version": 3,
  "name": "러너 팀즈 수집기",
  "short_name": "러너 팀즈",
  "version": "1.0.0",
  "description": "크롬에 열어 둔 팀즈 웹의 메시지 중 키워드에 걸린 것을 러너 올인원 관리자 대시보드로 보냅니다.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_popup": "popup.html", "default_title": "러너 팀즈 수집기", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "alarms", "tabs", "scripting"],
  "host_permissions": [
    "https://teams.microsoft.com/*",
    "https://teams.cloud.microsoft/*",
    "https://teams.live.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://teams.microsoft.com/*", "https://teams.cloud.microsoft/*", "https://teams.live.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
