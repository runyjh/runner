@echo off
rem Runner All-in-One PC installer (Windows 10/11). Creates desktop/start-menu shortcuts.
rem The PowerShell part below is read from this same file (after the #PSSTART line).
set "RUNNER_BAT=%~f0"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$f=$env:RUNNER_BAT; $s=[IO.File]::ReadAllText($f,[Text.Encoding]::UTF8); $i=$s.LastIndexOf('#PS'+'START'); iex $s.Substring($i)"
exit /b
#PSSTART

$ErrorActionPreference = 'Stop'
$AdminUrl = 'https://runyjh.github.io/runner/admin/'
$AppUrl   = 'https://runyjh.github.io/runner/'
$Dir = Join-Path $env:LOCALAPPDATA 'RunnerAllInOne'
New-Item -ItemType Directory -Force -Path $Dir | Out-Null
[IO.File]::WriteAllBytes((Join-Path $Dir 'admin.ico'), [Convert]::FromBase64String(''))
[IO.File]::WriteAllBytes((Join-Path $Dir 'app.ico'),   [Convert]::FromBase64String(''))

# 브라우저 찾기: 엣지(윈도우 기본) → 크롬
$cands = @(
  "${env:ProgramFiles(x86)}\Microsoft\Edge\Application\msedge.exe",
  "$env:ProgramFiles\Microsoft\Edge\Application\msedge.exe",
  "$env:LOCALAPPDATA\Microsoft\Edge\Application\msedge.exe",
  "$env:ProgramFiles\Google\Chrome\Application\chrome.exe",
  "${env:ProgramFiles(x86)}\Google\Chrome\Application\chrome.exe",
  "$env:LOCALAPPDATA\Google\Chrome\Application\chrome.exe"
)
$Browser = $cands | Where-Object { $_ -and (Test-Path $_) } | Select-Object -First 1

$Desktop = [Environment]::GetFolderPath('Desktop')
$Programs = [Environment]::GetFolderPath('Programs')
$Shell = New-Object -ComObject WScript.Shell

function Make-Link($name, $url, $icon) {
  foreach ($folder in @($Desktop, $Programs)) {
    $lnk = $Shell.CreateShortcut((Join-Path $folder ($name + '.lnk')))
    if ($Browser) { $lnk.TargetPath = $Browser; $lnk.Arguments = '--app=' + $url }
    else { $lnk.TargetPath = 'explorer.exe'; $lnk.Arguments = $url }
    $lnk.IconLocation = (Join-Path $Dir $icon) + ',0'
    $lnk.Description = $name
    $lnk.WorkingDirectory = $Dir
    $lnk.Save()
  }
  Write-Host ('  [완료] 바탕화면과 시작 메뉴에 "' + $name + '" 아이콘을 만들었습니다.') -ForegroundColor Green
}
function Remove-Link($name) {
  foreach ($folder in @($Desktop, $Programs)) { Remove-Item -Force -ErrorAction SilentlyContinue (Join-Path $folder ($name + '.lnk')) }
}

Clear-Host
Write-Host ''
Write-Host '  ==========================================' -ForegroundColor Cyan
Write-Host '        러너 올인원  PC 설치 프로그램' -ForegroundColor Cyan
Write-Host '  ==========================================' -ForegroundColor Cyan
Write-Host ''
Write-Host '   1. 러너 관리자 설치   (관리자 화면)'
Write-Host '   2. 러너 기사 앱 설치  (기사님 화면)'
Write-Host '   3. 둘 다 설치'
Write-Host '   4. 설치한 아이콘 지우기'
Write-Host ''
$c = Read-Host '  번호를 입력하고 Enter 를 누르세요 (그냥 Enter = 1)'
if (-not $c) { $c = '1' }
Write-Host ''
switch ($c.Trim()) {
  '1' { Make-Link '러너 관리자' $AdminUrl 'admin.ico' }
  '2' { Make-Link '러너 기사 앱' $AppUrl 'app.ico' }
  '3' { Make-Link '러너 관리자' $AdminUrl 'admin.ico'; Make-Link '러너 기사 앱' $AppUrl 'app.ico' }
  '4' { Remove-Link '러너 관리자'; Remove-Link '러너 기사 앱'; Remove-Item -Recurse -Force -ErrorAction SilentlyContinue $Dir; Write-Host '  [완료] 아이콘을 지웠습니다.' -ForegroundColor Green }
  default { Write-Host '  1~4 중에서 골라 주세요. 다시 실행해 주세요.' -ForegroundColor Yellow }
}
if ($c.Trim() -ne '4') {
  if ($Browser) { Write-Host ('  창이 주소창 없는 앱처럼 열립니다. (브라우저: ' + (Split-Path $Browser -Leaf) + ')') }
  else { Write-Host '  엣지·크롬을 찾지 못해 기본 브라우저로 열리게 만들었습니다.' -ForegroundColor Yellow }
  Write-Host '  처음 한 번은 로그인해 주세요. "로그인 유지"를 체크하면 다음부터 바로 열립니다.'
}
Write-Host ''
Read-Host '  Enter 를 누르면 창이 닫힙니다'
